# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Secrets (never commit real values)
INFERENCE_API_KEY=
ADMIN_API_KEY=

# llama-server (inside container)
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8000
LLAMA_BIN=/opt/llama/llama-server
LLAMA_CONTEXT_SIZE=8192
LLAMA_THREADS=4
LLAMA_BATCH_SIZE=
LLAMA_PARALLEL=
LLAMA_EXTRA_ARGS=

# Model
MODEL_NAME=Qwen2.5-Coder-3B-Instruct
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-3B-Instruct-GGUF/resolve/main/qwen2.5-coder-3b-instruct-q4_k_m.gguf
MODEL_FILE=current.gguf
MODEL_SHA256=724fb256bec1ff062b2f65e4569e871ad2e95ab2a3989723d1769c54294730b7
MODEL_DIR=/opt/qwen-model
MODEL_QUANT=Q4_K_M

# Optional automatic model updates (opt-in)
AUTO_UPDATE_MODEL=false
AUTO_UPDATE_INTERVAL=24h

# Analytics + risk layer (shared secret between gateway <-> analytics)
INGEST_SECRET=
ANALYTICS_URL=http://analytics:8081
ANALYTICS_GATEWAY_URL=http://gateway-dev:8080
ANALYTICS_PORT=8081
REDIS_URL=redis://redis:6379/0
ANALYTICS_DB_FILE=/opt/qwen-ml/analytics.db
ANALYTICS_FEATURE_WINDOW_SEC=60
ANALYTICS_CONTEXT_WINDOWS=12
ANALYTICS_EWMA_DECAY=0.1
ANALYTICS_PCA_COMPONENTS=6
ANALYTICS_PCA_WATCH_Z=1.0
ANALYTICS_PCA_HIGH_Z=1.5
ANALYTICS_ML_DIR=/opt/qwen-ml
ANALYTICS_EMBED_MODEL=risk.net
ANALYTICS_EMBED_ENABLED=false
ANALYTICS_TRAIN_MIN_ROWS=4000
ANALYTICS_TRAIN_EPOCHS=10
ANALYTICS_TRAIN_BATCH=64
ANALYTICS_TRAIN_TRIALS=5
ANALYTICS_TRAIN_VALIDATION=0.2
ANALYTICS_TRAIN_SEED=7