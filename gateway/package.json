{
  "name": "opencode-pi-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "opencode-pi Express gateway: OpenAI-compatible inference proxy, control plane, realtime events",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}